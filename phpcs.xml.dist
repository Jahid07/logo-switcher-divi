<?xml version="1.0"?>
<ruleset name="logo-switcher-divi">
    <description>WordPress standards; existing findings are tracked in phpcs-baseline.json.</description>
    <file>logo-switcher-divi.php</file>
    <file>Classes/</file>
    <file>uninstall.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <config name="testVersion" value="5.6-"/>
    <rule ref="WordPress"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
